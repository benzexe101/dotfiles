(defcfg
  linux-dev-names-include (
    "Telink Wireless Gaming Keyboard"
  )
  process-unmapped-keys yes
)

(defsrc
  caps h j k l u d y e w b
)

(deflayer base
  @cap _ _ _ _ _ _ _ _ _ _
)

(deflayer nav
  _    left down up right pgup pgdn home end C-right C-left
)

(defalias
  cap (tap-hold 200 200 esc (layer-while-held nav))
)
